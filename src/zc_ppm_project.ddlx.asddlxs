@Metadata.layer: #CORE
@UI.headerInfo : {
    typeName: 'Project',
    typeNamePlural: 'Projects',
    title : { type: #STANDARD, value: 'ProjectName' },
    description : { type: #STANDARD, value : 'ProjectId' }
 }
@UI.presentationVariant: [{
  sortOrder: [{
      by: 'ProjectID',
      direction: #ASC
  }]
}]
annotate view ZC_PPM_PROJECT with
{
  @UI.facet: [
  {
    label: 'General Information',
    id: 'General',
    purpose: #STANDARD,
    position: 10 ,
    type: #FIELDGROUP_REFERENCE,
    targetQualifier : 'General'
  },
  {
    label: 'Schedule',
    id: 'Schedule',
    purpose: #STANDARD,
    position: 20 ,
    type: #FIELDGROUP_REFERENCE,
    targetQualifier : 'Schedule'
  },
  {
    label: 'Progress',
    id: 'Progress',
    purpose: #STANDARD,
    position: 30 ,
    type: #FIELDGROUP_REFERENCE,
    targetQualifier : 'Progress'
  },
  {
    label: 'Milestones',
    id: 'Milestones',
    purpose: #STANDARD,
    position: 40 ,
    type: #LINEITEM_REFERENCE,
    targetElement: '_Milestone'
  }
   ]

  @UI.identification: [ { position: 10  } ]
  @UI.lineItem: [ { position: 10 , importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]
  @UI.fieldGroup: [{ qualifier: 'General', position: 10 }]
  ProjectID;

  @UI.identification: [ { position: 20 } ]
  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.selectionField: [ { position: 20 } ]
  @UI.fieldGroup: [{ qualifier: 'General', position: 20 }]
  ProjectName;

  @UI.identification: [ { position: 30 } ]
  @UI.fieldGroup: [{ qualifier: 'General', position: 30 }]
  Description;

  @UI.identification: [ { position: 40 } ]
  @UI.lineItem: [ { position: 30 } ]
  @UI.selectionField: [ { position: 30 } ]
  @UI.fieldGroup: [{ qualifier: 'Schedule', position: 10 }]
  StartDate;

  @UI.identification: [ { position: 50 } ]
  @UI.lineItem: [ { position: 40 } ]
  @UI.selectionField: [ { position: 40 } ]
  @UI.fieldGroup: [{ qualifier: 'Schedule', position: 20 }]
  EndDate;

  @UI.identification: [ { position: 60 } ]
  @UI.lineItem: [ { position: 50 } ]
  @UI.selectionField: [ { position: 50 } ]
  @UI.fieldGroup: [{ qualifier: 'General', position: 40 }]
  Status;

  @UI.identification: [ { position: 70 } ]
  @UI.lineItem: [ { position: 60 } ]
  @UI.fieldGroup: [{ qualifier: 'Progress', position: 10 }]
  CompletionPercentage;

}