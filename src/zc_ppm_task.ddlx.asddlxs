@Metadata.layer: #CORE
@UI.headerInfo : {
    typeName: 'Task',
    typeNamePlural: 'Tasks',
    title : { type: #STANDARD, value: 'TaskName' },
    description : { type: #STANDARD, value : 'TaskId' }
 }
@UI.presentationVariant: [{
  sortOrder: [{ by: 'TaskId', direction: #ASC }],
  visualizations: [{type: #AS_LINEITEM}]
}]
annotate view ZC_PPM_TASK with
{

  @UI.facet: [
    {
        label: 'General Information',
        id: 'General',
        purpose: #STANDARD,
        position: 10 ,
        type: #FIELDGROUP_REFERENCE,
        targetQualifier : 'General'
      },
      {
        label: 'Planning',
        id: 'Planning',
        purpose: #STANDARD,
        position: 20 ,
        type: #FIELDGROUP_REFERENCE,
        targetQualifier : 'Planning'
      },
      {
        label: 'Assignment',
        id: 'Assignment',
        purpose: #STANDARD,
        position: 30 ,
        type: #FIELDGROUP_REFERENCE,
        targetQualifier : 'Assignment'
      },
      {
        label: 'Status',
        id: 'Status',
        purpose: #STANDARD,
        position: 40 ,
        type: #FIELDGROUP_REFERENCE,
        targetQualifier : 'Status'
      }
  ]

  @UI.lineItem: [ { type: #FOR_ACTION, dataAction: 'startTask', label: 'Start Task' },
  { position: 10 }]
  @UI.identification: [ { type: #FOR_ACTION, dataAction: 'startTask', label: 'Start Task' },
  { position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.fieldGroup: [{ qualifier: 'General', position: 10 }]
  TaskId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [{ qualifier: 'General', position: 20 }]
  TaskName;

  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup: [{ qualifier: 'General', position: 30 }]
  Description;

  @UI.lineItem: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup: [{ qualifier: 'Assignment', position: 10 }]
  AssignedTo;

  @UI.lineItem: [{ position: 40 }]
  @UI.selectionField: [{ position: 40 }]
  @UI.fieldGroup: [{ qualifier: 'Planning', position: 10 }]
  Priority;

  @UI.lineItem: [{ position: 50 }]
  @UI.selectionField: [{ position: 50 }]
  @UI.fieldGroup: [{ qualifier: 'Status', position: 10 }]
  Status;

  @UI.lineItem: [{ position: 60 }]
  @UI.fieldGroup: [{ qualifier: 'Planning', position: 20 }]
  DueDate;

}