managed implementation in class ZBP_R_PPM_PROJECT unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_PPM_PROJECT alias Project
persistent table zppm_project_a
extensible
draft table zppm_project_d
etag master LocalLastChangedAt
lock master
total etag LastChangedAt
authorization master ( global )
{
  field ( readonly )
  ProjectUUID, ProjectID, CompletionPercentage, CreatedBy,
  CreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  field ( numbering : managed )
  ProjectUUID;

  field ( mandatory)
  ProjectName, Description, StartDate, EndDate;

  determination setProjectId on modify { create; }
  validation validateProjectDates on save { create; update; }

  action ( features : instance ) startProject result [1] $self;
  action ( features : instance) putOnHold result [1] $self;
  action ( features : instance) resumeProject result [1] $self;

  association _Milestone { create; with draft; }

  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare{
    validation validateProjectDates;
    validation Milestone~validateMilestoneDueDate;
    validation Task~validateTaskDueDate;
    validation Milestone~validateSequenceNumber;
    validation Task~validateCompletedTask; }

  mapping for zppm_project_a corresponding extensible
    {
      ProjectUUID          = PROJECT_UUID;
      ProjectID            = PROJECT_ID;
      ProjectName          = PROJECT_NAME;
      Description          = DESCRIPTION;
      StartDate            = START_DATE;
      EndDate              = END_DATE;
      Status               = STATUS;
      CompletionPercentage = completion_percentage;
      CreatedBy            = CREATED_BY;
      CreatedAt            = CREATED_AT;
      LocalLastChangedBy   = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt   = LOCAL_LAST_CHANGED_AT;
      LastChangedAt        = LAST_CHANGED_AT;
    }

}

define behavior for ZR_PPM_MILESTONE alias Milestone
persistent table zppm_milestone_a
draft table zppm_milestome_d
lock dependent by _Project
authorization dependent by _Project
{
  field ( readonly )
  MilestoneUuid, ProjectUuid, MilestoneId, CreatedBy,
  CreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  field ( numbering : managed )
  MilestoneUuid;

  field ( mandatory)
  MilestoneName, Description, SequenceNo, DueDate;

  determination setMilestoneId on modify { create; }
  determination synchronizeProjectStatus on modify { field Status; create; update; delete; }

  validation validateMilestoneDueDate on save { create; update; }
  validation validateSequenceNumber on save { create; update; }

  association _Project { with draft; }
  association _Task { create; with draft; }

  update;
  delete;

  mapping for zppm_milestone_a corresponding
    {
      MilestoneUuid      = milestone_uuid;
      ProjectUuid        = project_uuid;
      MilestoneId        = milestone_id;
      MilestoneName      = milestone_name;
      Description        = description;
      SequenceNo         = sequence_no;
      DueDate            = due_date;
      Status             = status;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }
}


define behavior for ZR_PPM_TASK alias Task
persistent table zppm_task_a
draft table zppm_task_d
lock dependent by _Project
authorization dependent by _Project
{
  field ( readonly )
  TaskUuid, MilestoneUuid, ProjectUuid, TaskId,
  CreatedBy, CreatedAt, LocalLastChangedBy, LocalLastChangedAt,
  LastChangedAt;

  field ( numbering : managed )
  TaskUuid;

  field ( mandatory )
  TaskName, Description, Priority, DueDate;

  determination setTaskId on modify { create; }
  determination calculateProjectCompletion on modify { field Status; create; update; delete; }
  determination synchronizeMilestoneStatus on modify { field Status; create; update; delete; }

  validation validateTaskDueDate on save { create; update; }
  validation validateCompletedTask on save { create; update; }

  association _Milestone { with draft; }
  association _Project { with draft; }

  update;
  delete;

  mapping for zppm_task_a corresponding
    {
      TaskUuid           = task_uuid;
      MilestoneUuid      = milestone_uuid;
      ProjectUuid        = project_uuid;
      TaskId             = task_id;
      TaskName           = task_name;
      Description        = description;
      AssignedTo         = assigned_to;
      Priority           = priority;
      Status             = status;
      DueDate            = due_date;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }
}